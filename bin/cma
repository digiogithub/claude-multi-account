#!/bin/sh
# CMA_MANAGED_SHIM: repository entry point; never builds implicitly.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ ! -f "$root/dist/cma" ] || [ ! -x "$root/dist/cma" ]; then
    printf '%s\n' 'cma: compiled Linux binary is missing. Run make build in the repository root, or make install explicitly in a terminal.' >&2
    exit 2
fi
exec "$root/dist/cma" "$@"
